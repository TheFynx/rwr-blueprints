#!/bin/bash
# Fit after the compositor has settled the PTY; refit after every resize.
set -u
base="$HOME/.local/state/omarchy/current/theme/screensaver"
art=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/midgar-art.XXXXXX")
child=""
cleanup() {
  trap - EXIT INT TERM HUP QUIT
  [[ -z $child ]] || { kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; }
  rm -f "$art"
  printf '\033[?25h\033[0m'
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP QUIT
hyprctl eval 'hl.config({ cursor = { invisible = true } })' >/dev/null 2>&1 || true
printf '\033]11;rgb:0b/11/16\007\033[?25l'
last=""; stable=0
for ((n=0; n<60; n++)); do
  size=$(stty size)
  if [[ $size == "$last" && $size != "24 80" ]]; then ((stable+=1)); else stable=0; fi
  (( stable >= 5 )) && break
  last=$size
  sleep 0.05
done
while true; do
  read -r rows cols < <(stty size)
  python3 "$base/fit-cloud.py" "$base/cloud-original.txt" "$cols" "$rows" > "$art" || exit 1
  printf '\033[2J\033[H'
  ttfx -i "$art" --frame-rate 30 --canvas-width 0 --canvas-height 0 \
    --anchor-canvas c --anchor-text c --reuse-canvas --no-eol --no-restore-cursor \
    --terminal-background-color 0b1116 colorshift \
    --gradient-stops 63e6be 79d8de bc9be7 63e6be --gradient-steps 24 --gradient-frames 8 \
    --final-gradient-stops 63e6be 79d8de --cycles 3 &
  child=$!
  while kill -0 "$child" 2>/dev/null; do
    if read -rsn1 -t 0.25 || ! hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null; then
      exit 0
    fi
    if [[ $(stty size) != "$rows $cols" ]]; then
      kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; break
    fi
  done
  wait "$child" 2>/dev/null || true
  child=""
done
