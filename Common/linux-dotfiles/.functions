#!/usr/bin/env bash
# Thin shims over the fynx CLI (~/git/thefynx/cli). fynx owns the logic
# itself: docker cleanup, disk usage, DNS lookups, colored man pages,
# reachability probes, repo scans, and source-tree export. The old shell
# implementations retired with this file had two real bugs the CLI fixes
# (isup reported the opposite verdict; copy_repo_contents re-extracted
# cmd/ and internal/ under /).
#
# On machines provisioned without the CLI checkout these aliases simply
# do not exist; fish keeps inline fallbacks for those cases.

if command -v fynx >/dev/null 2>&1; then
    alias dclean='fynx docker clean'
    alias fs='fynx disk usage'
    alias digga='fynx dns lookup'
    alias man='fynx man'
    alias isup='fynx net isup'
    alias git-check='fynx repo check'
    alias copy_repo_contents='fynx repo contents'
fi