QPushButton, QToolButton { border: 2px solid #7b6c90; border-radius: 0; border-top-color: #a496b3; border-left-color: #a496b3; border-bottom-color: #0d0b12; border-right-color: #0d0b12; padding: 5px; background: #30283e; color: #e7def0; }
QPushButton:hover, QToolButton:hover { border-color: #bd9ae6; }
QLineEdit, QComboBox { border: 2px solid #7b6c90; border-radius: 0; background: #121019; padding: 4px; }
QProgressBar::chunk { background: #bd9ae6; }
QLineEdit:focus { border-color: #bd9ae6; }
QMenu { background: #1b1823; color: #e7def0; border: 2px solid #bd9ae6; }
QMenu::item:selected { background: #3d3155; }
QHeaderView::section { background: #30283e; color: #e7def0; border: 1px solid #7b6c90; padding: 5px; }
QScrollBar::handle { background: #7b6c90; border-radius: 0; }
